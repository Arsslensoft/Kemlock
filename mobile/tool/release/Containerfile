# The environment a release of the free build is built in (openspec:
# add-fdroid-release, design decisions 6 and 7). Everything in it is fixed:
# the base image by digest, Debian's packages by one day's snapshot, and each
# tool by a checksum, so the same file gives the same image a year from now.
#
#   docker build -t kemlock-release -f tool/release/Containerfile tool/release
#
# The paths are those of F-Droid's build server, so that a path that ends up
# in a build is the same in both: the app at /home/vagrant/build/com.kemlock.app,
# Flutter at /home/vagrant/build/srclib/flutter, the SDK at /opt/android-sdk.
# build.sh, run in it, makes the APKs; verify.sh wraps both for a stranger.
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

# Debian's packages as they were on one day. Signatures are still checked;
# only their expiry dates, long past in a snapshot, are not.
RUN rm -f /etc/apt/sources.list.d/debian.sources \
 && printf '%s\n' \
    'deb http://snapshot.debian.org/archive/debian/20261101T000000Z bookworm main' \
    'deb http://snapshot.debian.org/archive/debian/20261101T000000Z bookworm-updates main' \
    'deb http://snapshot.debian.org/archive/debian-security/20261101T000000Z bookworm-security main' \
    > /etc/apt/sources.list \
 && apt-get -o Acquire::Check-Valid-Until=false update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    openjdk-17-jdk-headless git curl ca-certificates unzip xz-utils zip file \
    apksigcopier diffoscope-minimal \
 && rm -rf /var/lib/apt/lists/*

# The build runs as F-Droid's does, as an ordinary user in /home/vagrant.
RUN useradd --create-home --home-dir /home/vagrant --uid 1000 vagrant \
 && mkdir -p /opt/android-sdk /home/vagrant/build/srclib /out \
 && chown -R vagrant:vagrant /opt/android-sdk /home/vagrant /out
USER vagrant
ENV HOME=/home/vagrant \
    LANG=C.UTF-8 \
    TZ=UTC \
    JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 \
    ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    FLUTTER_ROOT=/home/vagrant/build/srclib/flutter \
    PUB_CACHE=/home/vagrant/.pub-cache \
    FLUTTER_SUPPRESS_ANALYTICS=true \
    DART_SUPPRESS_ANALYTICS=true
ENV PATH=$FLUTTER_ROOT/bin:$ANDROID_HOME/cmdline-tools/latest/bin:$JAVA_HOME/bin:$PATH

# The Android command-line tools, then the SDK packages the build uses, at
# fixed versions. sdkmanager checks each download against Google's SHA-1; the
# installed trees are checked against tools.sha256 below.
RUN curl -fsSL https://dl.google.com/android/repository/commandlinetools-linux-16111833_latest.zip -o /tmp/tools.zip \
 && echo "0877a1d048fe4a24efe2eff536ca4223f7adeb58648bb81909d33c446918cfa8  /tmp/tools.zip" | sha256sum -c - \
 && unzip -q /tmp/tools.zip -d /tmp/tools \
 && mkdir -p $ANDROID_HOME/cmdline-tools \
 && mv /tmp/tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest \
 && rm -rf /tmp/tools /tmp/tools.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager --install \
    "platforms;android-37.0" "platforms;android-36" "platforms;android-35" "platforms;android-34" \
    "build-tools;36.0.0" "build-tools;34.0.0" \
    "ndk;28.2.13676358" "cmake;3.22.1" >/dev/null \
 && rm -rf $HOME/.android/cache

# Flutter 3.47.7, the version mobile.yml's checks run, by its published SHA-256,
# then the engine's Android artifacts.
RUN curl -fsSL https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.47.7-stable.tar.xz -o /tmp/flutter.tar.xz \
 && echo "af7455f540df951184c7953fbe3cf884766e7541dacf8571f9f582db03dd6230  /tmp/flutter.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/flutter.tar.xz -C /home/vagrant/build/srclib \
 && rm /tmp/flutter.tar.xz \
 && git config --global --add safe.directory '*' \
 && flutter config --no-analytics --no-cli-animations >/dev/null \
 && dart --disable-analytics >/dev/null \
 && flutter precache --android --no-ios --no-web --no-linux --no-windows --no-macos --no-fuchsia >/dev/null

# The Android Gradle plugin reads the SDK quickly only when platform-tools is
# there; without it, it falls back to a reader of an older SDK format and
# finds no android-37 platform. Only the latest is offered, so the check below
# pins it: a newer one stops the image until tools.sha256 is updated.
RUN sdkmanager --install platform-tools >/dev/null && rm -rf $HOME/.android/cache

# What was installed, against the sums recorded the first time: a changed
# file anywhere in these trees stops the image here.
COPY --chown=vagrant:vagrant tree_sum.sh tools.sha256 /home/vagrant/tools/
RUN /home/vagrant/tools/tree_sum.sh --check /home/vagrant/tools/tools.sha256

# A missing SDK package fails the build instead of being fetched unpinned.
RUN mkdir -p $HOME/.gradle \
 && printf '%s\n' 'android.builder.sdkDownload=false' 'org.gradle.daemon=false' > $HOME/.gradle/gradle.properties

COPY --chown=vagrant:vagrant build.sh /home/vagrant/tools/
WORKDIR /home/vagrant/build
