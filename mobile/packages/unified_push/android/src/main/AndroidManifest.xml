<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The connector's own manifest adds what it needs (the WAKE_LOCK permission, the queries that find the
         distributors on Android 11 and later, and its link activity), and the receiver that hands the
         distributors' broadcasts to this service. -->
    <application>
        <!-- Receives what the person's distributor sends: a new endpoint, a lost registration, a failed one and
             each push message. Not exported: the connector binds to it from inside the app. -->
        <service
            android:name="com.kemlock.unified_push.KemlockPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
