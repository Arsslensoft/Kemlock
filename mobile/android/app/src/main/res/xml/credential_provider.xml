<?xml version="1.0" encoding="utf-8"?>
<!-- Kemlock's passkey provider (KemlockCredentialService): passkeys only, no passwords.
     The gear beside it in the phone's settings opens the app. -->
<credential-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="com.kemlock.app.MainActivity">
    <capabilities>
        <capability name="android.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
