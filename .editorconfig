# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Dart: dart format sets the layout (page width 140, in mobile/analysis_options.yaml).
[*.dart]
max_line_length = 140

[*.{kt,kts,java,gradle,swift}]
indent_size = 4

[*.{py,sh}]
indent_size = 4

[*.md]
# A trailing double space is a line break in Markdown.
trim_trailing_whitespace = false

# Xcode writes tabs.
[*.{pbxproj,xcscheme,xcworkspacedata}]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf

# Bytes other apps and other versions wrote, or that are copied as their publisher serves them, and
# that tests compare byte for byte (see .gitattributes): an editor must not touch them.
[mobile/test/fixtures/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[mobile/assets/data/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[mobile/android/app/src/main/assets/password-manager-resources/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
